<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup + device transfer: same exclusions as backup_rules.xml (session, Health Connect state, push
     registration). noBackupFilesDir (install_id, event queue, launch cache) is never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rasi.fiters.session.xml" />
        <exclude domain="sharedpref" path="rasi.health.xml" />
        <exclude domain="sharedpref" path="rasi.push.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rasi.fiters.session.xml" />
        <exclude domain="sharedpref" path="rasi.health.xml" />
        <exclude domain="sharedpref" path="rasi.push.xml" />
    </device-transfer>
</data-extraction-rules>
