# RaSi Fiters backend — environment template (copy to .env.local; never commit real values)
# Canonical runbook: ../../ENV_RUNBOOK.md. Faithful migration delta: specs/features/auth/SPEC.md §6/§7.

# --- Database (Supabase Postgres) -----------------------------------------------------------------
# Replaces the legacy DB_URL (Render). Use the Supabase session-pooler / direct connection string.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# --- Supabase Auth (the credential store + token issuer/verifier; R1) ----------------------------
SUPABASE_URL=https://kpadxjekpiwfkqcxtrio.supabase.co
SUPABASE_ANON_KEY=            # anon key — fallback for the sign-in / refresh proxy while SUPABASE_SECRET_KEY is unset
SUPABASE_SERVICE_ROLE_KEY=    # service-role key — used for admin createUser/updateUser/deleteUser
SUPABASE_SECRET_KEY=          # secret API key (sb_secret_…) — calls made on a user's behalf + Sb-Forwarded-For (auth D-C14); unset → anon key, no IP forwarding
# JWT verification (D-C2): JWKS endpoint for the project's ASYMMETRIC signing keys (ES256).
# Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json if unset.
# NOTE: the project must have JWT signing keys migrated to asymmetric (ECC P-256) in the Supabase
# dashboard (Auth → JWT Keys) for JWKS verification to find a key — see PROGRESS.md.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISS=            # optional issuer override; defaults to ${SUPABASE_URL}/auth/v1

# --- Server ---------------------------------------------------------------------------------------
PORT=5001
MIN_IOS_VERSION=1.2.0
# --- Version gate (app-config SPEC v0.2.0, D-C4/D-C5) — leave unset: nobody is blocked, nudged or 426'd ---
# LATEST_IOS_VERSION=<x.y.z>              # iOS soft "Update available" nudge below this marketing version
# MIN_ANDROID_VERSION_CODE=<versionCode>  # Android hard minimum versionCode (blocking update screen)
# LATEST_ANDROID_VERSION_CODE=<versionCode>  # Android soft-nudge versionCode
# BLOCK_UNVERSIONED_ANDROID=true          # 426 every header-less Android (1.0.0) /api request — default OFF

# --- Observability (specs/features/observability, D-C2) ------------------------------------------
# Sequelize SQL query logging. Unset / anything but "true" = OFF (prod: leave unset). "true" prints every
# query to stdout — local debugging only (queries carry usernames, emails and push tokens as literals).
DB_LOG_SQL=
# TRUST_PROXY_HOPS=3   # Express `trust proxy` hops (D-C7): integer 1–5, unset/other = 2 (prod: leave unset); staging = 3

# --- Staging only (auth SPEC D-C13) — NEVER set on prod ---------------------------------------------
# APP_ENV=staging                    # turns on utils/stagingGuard.js (login-change guard, staging-only reset mail, schema check)
# CORS_EXTRA_ORIGINS=https://rasifiters-git-staging-personal-vinayak.vercel.app   # comma-separated, appended to CORS
